# Copy this file to secrets.toml and fill in your Snowflake credentials
# DO NOT commit secrets.toml to version control

[snowflake]
user = "your_username"
password = "your_password"
account = "your_account"  # e.g., "abc12345.us-east-1"
warehouse = "your_warehouse"  # e.g., "COMPUTE_WH"
role = "your_role"  # Must have access to SNOWFLAKE.ACCOUNT_USAGE views
